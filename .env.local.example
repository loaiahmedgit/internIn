# Database (Supabase Postgres connection string, "Session pooler" or direct)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (OpenRouter). Leave OPENROUTER_API_KEY unset to use the mock AI
# provider instead — the app works fully without this for demos.
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-4-31b-it-20260402

# Email (Phase 6)
RESEND_API_KEY=

# Analytics / error tracking (Phase 6)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Same DSN value in both — SENTRY_DSN for server/edge instrumentation,
# NEXT_PUBLIC_SENTRY_DSN so it actually gets inlined into the client bundle
# (Sentry DSNs are meant to be public; they can only submit events, not read data).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Background jobs (Phase 6). Leave unset to run Inngest's local dev server
# instead (`npx inngest-cli dev -u http://localhost:3000/api/inngest`) — these
# keys only matter once deployed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# If INNGEST_EVENT_KEY/SIGNING_KEY above are set (real prod keys), also set
# this to test locally against `inngest-cli dev` — otherwise the SDK assumes
# production ("cloud") mode and refuses the dev server's sync ("Expected
# server kind cloud, got dev"). Never set this in an actual deployment.
INNGEST_DEV=1
# Used to build links in background-job emails (e.g. invite notifications).
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=
